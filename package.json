{
  "name": "ai-image-studio",
  "version": "1.5.1",
  "description": "OpenAI-compatible local creative workspace for Windows",
  "author": "zztnbnb",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/zztnbnb/image-studio.git"
  },
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "tsc -p tsconfig.json && vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "package:win": "npm run build && electron-builder --win nsis --x64 && npm run package:verify",
    "package:verify": "node tools/verify-package.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@types/archiver": "^8.0.0",
    "archiver": "^8.0.0",
    "archiver-utils": "^5.0.2",
    "electron-updater": "6.8.9",
    "keytar": "^7.9.0",
    "onnxruntime-web": "^1.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "build": {
    "appId": "com.zztnbnb.pinaic.imagestudio",
    "productName": "AI Image Studio",
    "artifactName": "AI-Image-Studio-Setup-${version}.${ext}",
    "asar": true,
    "afterPack": "tools/after-pack.cjs",
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "zztnbnb",
        "repo": "image-studio",
        "releaseType": "release"
      }
    ],
    "files": [
      "**/*",
      "!chat-tool{,/**/*}",
      "!保存图片{,/**/*}",
      "!*.log"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "AI Image Studio.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Image Studio"
    }
  },
  "devDependencies": {
    "@electron/asar": "^4.3.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "rcedit": "^5.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  }
}
